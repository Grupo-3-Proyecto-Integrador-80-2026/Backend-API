# Backend
PORT=3000
GOOGLE_APPLICATION_CREDENTIALS=./credentials/serviceAccountKey.json

# Solo para docker-compose: configuración web de Firebase que se le pasa al frontend al construirlo
# (Firebase Console → Configuración del proyecto → Tus apps → App web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
